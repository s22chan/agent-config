prefix_rule(
    pattern = [["gh", "/bin/gh", "/usr/bin/gh", "/usr/local/bin/gh"]],
    decision = "forbidden",
    justification = "Describe the PR operation for the user to perform in the GitHub web UI.",
    match = ["gh pr view 123", "/usr/bin/gh api repos/example/project"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], "add", [".", "-A", "--all"]],
    decision = "forbidden",
    justification = "Stage explicit files only.",
    match = ["git add .", "/usr/bin/git add -A", "git add --all"],
    not_match = ["git add src/app.py"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], "push", ["--force", "-f", "--force-with-lease"]],
    decision = "prompt",
    justification = "Force-push requires explicit user approval.",
    match = ["git push --force", "/usr/bin/git push --force-with-lease origin topic"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], "commit", ["--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Fix the failing hook and rerun the real commit without bypassing verification.",
    match = ["git commit --no-verify -m fix", "/usr/bin/git commit -n -m fix"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], ["merge", "rebase"], "--no-verify"],
    decision = "forbidden",
    justification = "Run the operation with its configured hooks instead of bypassing verification.",
    match = ["git merge --no-verify topic", "/usr/bin/git rebase --no-verify main"],
    not_match = ["git merge -n topic", "git rebase main"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], "commit", "--amend"],
    decision = "prompt",
    justification = "Confirm the proposed message or history rewrite before amending.",
    match = ["git commit --amend", "/usr/bin/git commit --amend -F message.txt"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], "rebase", ["-i", "--interactive"]],
    decision = "prompt",
    justification = "Preview and approve the history rewrite before starting an interactive rebase.",
    match = ["git rebase -i HEAD~3", "/usr/bin/git rebase --interactive main"],
)

prefix_rule(
    pattern = [["git", "/bin/git", "/usr/bin/git", "/usr/local/bin/git"], ["rebase", "merge"], "--abort"],
    decision = "prompt",
    justification = "Inspect the interrupted operation and obtain approval before aborting it.",
    match = ["git rebase --abort", "/usr/bin/git merge --abort"],
)
