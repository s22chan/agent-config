#!/usr/bin/env bash

set -euo pipefail

budget_usd=${S22CHAN_CLAUDE_AUDIT_MAX_BUDGET_USD:-5}
if [[ ${1-} == --budget-usd ]]; then
  if [[ $# -lt 2 ]]; then
    printf 'usage: %s [--budget-usd USD] [audit arguments...]\n' "$0" >&2
    exit 2
  fi
  budget_usd=$2
  shift 2
fi

prompt=/audit
if [[ $# -gt 0 ]]; then
  prompt+=" $*"
fi

exec claude -p --max-budget-usd "$budget_usd" "$prompt"
