#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///

import json
import os
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Mapping
from pathlib import Path

EVIDENCE_ENV = "S22CHAN_AUDIT_EVIDENCE_DIR"

# A headless run has no approval prompt, so anything not pre-approved here is
# denied and the coordinator stops before dispatching a reviewer. Writes are
# limited to the evidence directory; commands are limited to read-only forms.
READ_ONLY_COMMANDS = (
    "git rev-parse", "git log", "git show", "git diff", "git merge-base",
    "git ls-tree", "git ls-files", "git cat-file", "git grep", "git status",
    "git check-ignore", "git rev-list", "git for-each-ref", "git show-ref",
    "git diff-tree", "git branch --list", "git branch --show-current",
    "git remote get-url", "git remote -v",
    "cat", "ls", "wc", "sed", "awk", "grep", "rg", "head", "tail", "sort",
    "uniq", "cut", "tr", "comm", "diff", "sha256sum", "stat", "realpath",
    "basename", "dirname", "printenv", "date", "echo", "cd",
)


def permission_arguments(evidence: Path, worktree: Path) -> list[str]:
    """Pre-approves writes to the evidence directory and denies the worktree.

    A leading double slash marks an absolute path in permission rules; a single
    slash is relative to the project root and would not match.
    """
    allowed = [f"Write(/{evidence}/**)", f"Edit(/{evidence}/**)"]
    allowed += [f"Bash({command}:*)" for command in READ_ONLY_COMMANDS]
    denied = [
        f"Write(/{worktree}/**)",
        f"Edit(/{worktree}/**)",
        "Bash(sed -i:*)",
        "Bash(sed --in-place:*)",
    ]
    return [
        "--add-dir", str(evidence),
        "--allowedTools", *allowed,
        "--disallowedTools", *denied,
    ]


def usage_value(usage: Mapping, snake_name: str, camel_name: str) -> int:
    value = usage.get(snake_name, usage.get(camel_name, 0))
    return value if isinstance(value, int) else 0


def format_usage(label: str, usage: Mapping, cost: object = None) -> str:
    input_tokens = usage_value(usage, "input_tokens", "inputTokens")
    cache_write = usage_value(
        usage, "cache_creation_input_tokens", "cacheCreationInputTokens"
    )
    cache_read = usage_value(
        usage, "cache_read_input_tokens", "cacheReadInputTokens"
    )
    output_tokens = usage_value(usage, "output_tokens", "outputTokens")
    total_input = input_tokens + cache_write + cache_read
    cache_share = cache_read / total_input if total_input else 0.0
    fields = [
        f"input={input_tokens:,}",
        f"cache_write={cache_write:,}",
        f"cache_read={cache_read:,}",
        f"cache_read_share={cache_share:.1%}",
        f"output={output_tokens:,}",
    ]
    if isinstance(cost, (int, float)):
        fields.append(f"cost=${cost:.4f}")
    return f"{label}: " + " ".join(fields)


def aggregate_model_usage(model_usage: Mapping) -> dict[str, int]:
    totals = {
        "input_tokens": 0,
        "cache_creation_input_tokens": 0,
        "cache_read_input_tokens": 0,
        "output_tokens": 0,
    }
    for values in model_usage.values():
        if not isinstance(values, Mapping):
            continue
        for snake_name, camel_name in (
            ("input_tokens", "inputTokens"),
            ("cache_creation_input_tokens", "cacheCreationInputTokens"),
            ("cache_read_input_tokens", "cacheReadInputTokens"),
            ("output_tokens", "outputTokens"),
        ):
            totals[snake_name] += usage_value(values, snake_name, camel_name)
    return totals


def emit_result(payload: Mapping) -> None:
    result = payload.get("result")
    if not isinstance(result, str):
        raise TypeError("Claude JSON result has no textual result")
    sys.stdout.write(result)
    if result and not result.endswith("\n"):
        sys.stdout.write("\n")

    usage = payload.get("usage")
    model_usage = payload.get("modelUsage")
    if isinstance(model_usage, Mapping) and model_usage:
        aggregate_usage = aggregate_model_usage(model_usage)
    elif isinstance(usage, Mapping):
        aggregate_usage = usage
    else:
        aggregate_usage = None
    if aggregate_usage is not None:
        print(
            format_usage(
                "audit usage", aggregate_usage, payload.get("total_cost_usd")
            ),
            file=sys.stderr,
        )
    else:
        print("audit usage: unavailable", file=sys.stderr)

    if isinstance(model_usage, Mapping):
        for model, values in sorted(model_usage.items()):
            if isinstance(values, Mapping):
                print(
                    format_usage(
                        f"audit usage [{model}]", values, values.get("costUSD")
                    ),
                    file=sys.stderr,
                )


def main() -> int:
    arguments = sys.argv[1:]
    budget_usd = os.environ.get("S22CHAN_CLAUDE_AUDIT_MAX_BUDGET_USD", "5")
    if arguments[:1] == ["--budget-usd"]:
        if len(arguments) < 2:
            print(
                f"usage: {sys.argv[0]} [--budget-usd USD] [audit arguments...]",
                file=sys.stderr,
            )
            return 2
        budget_usd = arguments[1]
        arguments = arguments[2:]

    prompt = "/audit"
    if arguments:
        prompt += " " + " ".join(arguments)
    evidence = Path(tempfile.mkdtemp(prefix="audit-evidence-")).resolve()
    command = [
        "claude",
        "-p",
        "--max-budget-usd",
        budget_usd,
        "--output-format",
        "json",
        "--exclude-dynamic-system-prompt-sections",
        *permission_arguments(evidence, Path.cwd().resolve()),
        "--",
        prompt,
    ]
    completed = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        env={**os.environ, EVIDENCE_ENV: str(evidence)},
    )
    sys.stderr.write(completed.stderr)
    if completed.returncode != 0:
        sys.stdout.write(completed.stdout)
        print(f"audit evidence kept at {evidence}", file=sys.stderr)
        return completed.returncode
    shutil.rmtree(evidence, ignore_errors=True)

    try:
        emit_result(json.loads(completed.stdout))
    except (json.JSONDecodeError, TypeError) as error:
        sys.stdout.write(completed.stdout)
        print(f"audit usage: cannot decode Claude result: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
